    {
      "parameters": {
        "jsCode": "const state = $input.first().json || {};\nconst telegramData = $('Telegram Trigger').first().json;\nconst newUserAnswer = telegramData.message?.text || '';\nconst currentQ = Number.parseInt(state.current_q, 10) || 0;\nconst totalQuestions = Number.parseInt(state.total_questions, 10) || 0;\nlet answers = [];\ntry {\n  if (Array.isArray(state.answers)) answers = state.answers;\n  else if (typeof state.answers === 'string' && state.answers.trim()) {\n    const parsed = JSON.parse(state.answers);\n    if (Array.isArray(parsed)) answers = parsed;\n  }\n} catch (e) { answers = []; }\nif (currentQ >= totalQuestions) throw new Error('Exam is already complete; refusing to append another answer.');\nconst qId = currentQ + 1;\n// Replace an existing entry for this question rather than creating a duplicate.\nanswers = answers.filter(a => Number(a.q_id) !== qId);\nanswers.push({ q_id: qId, user_ans: newUserAnswer, timestamp: new Date().toISOString() });\nreturn { json: {\n  user_id: String(state.user_id), current_q: qId, answers: JSON.stringify(answers),\n  started_at: state.started_at, total_questions: totalQuestions,\n  max_score: totalQuestions * 10, is_finished: qId >= totalQuestions\n} };"
      },

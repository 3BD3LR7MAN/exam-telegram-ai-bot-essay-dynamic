    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "=النتيجة 🎉\n\nالمجموع: {{ $('Parse AI Result').item.json.total }} / {{ $('Parse AI Result').item.json.max_score }}\nالنسبة: {{ $('Parse AI Result').item.json.percentage }}%\n\n{{ $('Parse AI Result').item.json.feedback }}",

    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text ?? $input.first().json.output ?? '';\nconst state = $('Update State').first().json;\nconst totalQuestions = Number(state.total_questions) || 0;\nconst maxScore = totalQuestions * 10;\nlet parsed;\ntry {\n  if (typeof raw === 'object' && raw !== null) parsed = raw;\n  else {\n    const text = String(raw).trim();\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    parsed = JSON.parse(match ? match[0] : text);\n  }\n} catch (e) { parsed = {}; }\nlet total = Number(parsed.total);\nif (!Number.isFinite(total)) total = 0;\ntotal = Math.max(0, Math.min(maxScore, Math.round(total)));\nconst percentage = maxScore > 0 ? Math.round((total / maxScore) * 100) : 0;\nconst answers = $('Merge Answers with Model').first().json.answers || [];\nreturn { json: {\n  user_id: state.user_id,\n  total,\n  percentage,\n  feedback: typeof parsed.feedback === 'string' && parsed.feedback.trim() ? parsed.feedback.trim() : 'تم حفظ إجاباتك، لكن تعذر إنشاء ملاحظة التقييم.',\n  total_questions: totalQuestions,\n  max_score: maxScore,\n  answers_json: JSON.stringify(answers),\n  evaluated_at: new Date().toISOString()\n} };"
      },
